{{ define "header" }}
{{- $lang := or (index .Page.Meta "lang") "fr" -}}
{{- $frURL := "" -}}
{{- $enURL := "" -}}
{{- if eq $lang "en" -}}
  {{- $frURL = or (index .Page.Meta "alternate") "/" -}}
{{- else -}}
  {{- $enURL = or (index .Page.Meta "alternate") "/en-us/" -}}
{{- end -}}
<header class="header" id="site-header">
  <div class="header__inner">
    <a href="{{ if eq $lang "en" }}{{ contentURL "en-us/README.md" }}{{ else }}/{{ end }}" class="header__logo" aria-label="{{ if eq $lang "en" }}Monolithic Lab — Home{{ else }}Monolithic Lab — Accueil{{ end }}">
      <span class="header__logo-mark" aria-hidden="true"></span>
      <span class="header__logo-text">Monolithic Lab</span>
    </a>

    <nav class="header__nav" aria-label="{{ if eq $lang "en" }}Main navigation{{ else }}Navigation principale{{ end }}">
      <ul class="header__nav-list">
        <li><a href="{{ if eq $lang "en" }}{{ contentURL "en-us/approach.md" }}{{ else }}{{ contentURL "approche.md" }}{{ end }}" class="header__nav-link">{{ if eq $lang "en" }}Approach{{ else }}Approche{{ end }}</a></li>
        <li class="header__nav-item header__nav-item--has-submenu">
          <a href="{{ if eq $lang "en" }}{{ contentURL "en-us/expertise.md" }}{{ else }}{{ contentURL "expertises.md" }}{{ end }}" class="header__nav-link">{{ if eq $lang "en" }}Services{{ else }}Offres{{ end }}</a>
          <div class="header__submenu">
            <div class="header__submenu-panel">
              <a href="{{ if eq $lang "en" }}{{ contentURL "en-us/fractional-cto.md" }}{{ else }}{{ contentURL "cto-temps-partage.md" }}{{ end }}" class="header__submenu-link">{{ if eq $lang "en" }}Fractional CTO{{ else }}CTO à temps partagé{{ end }}</a>
              <a href="{{ if eq $lang "en" }}{{ contentURL "en-us/interim-cto.md" }}{{ else }}{{ contentURL "cto-de-transition.md" }}{{ end }}" class="header__submenu-link">{{ if eq $lang "en" }}Interim CTO{{ else }}CTO de transition{{ end }}</a>
              <a href="{{ if eq $lang "en" }}{{ contentURL "en-us/ai-transformation.md" }}{{ else }}{{ contentURL "transformation-ia.md" }}{{ end }}" class="header__submenu-link">{{ if eq $lang "en" }}AI transformation{{ else }}Transformation IA{{ end }}</a>
              <a href="{{ if eq $lang "en" }}{{ contentURL "en-us/fixed-price-projects.md" }}{{ else }}{{ contentURL "missions-au-forfait.md" }}{{ end }}" class="header__submenu-link">{{ if eq $lang "en" }}Fixed-price projects{{ else }}Missions au forfait{{ end }}</a>
            </div>
          </div>
        </li>
        <li><a href="{{ if eq $lang "en" }}{{ contentURL "en-us/articles/README.md" }}{{ else }}{{ contentURL "articles/README.md" }}{{ end }}" class="header__nav-link">Articles</a></li>
        <li><a href="{{ if eq $lang "en" }}{{ contentURL "en-us/references.md" }}{{ else }}{{ contentURL "references.md" }}{{ end }}" class="header__nav-link">{{ if eq $lang "en" }}References{{ else }}Références{{ end }}</a></li>
      </ul>
    </nav>

    <div class="header__actions">
      <nav class="lang-switcher" aria-label="{{ if eq $lang "en" }}Language{{ else }}Langue{{ end }}">
        {{ if eq $lang "fr" }}<span class="lang-switcher__link lang-switcher__link--active" lang="fr" aria-current="true">FR</span>{{ else }}<a href="{{ $frURL }}" class="lang-switcher__link" lang="fr" hreflang="fr">FR</a>{{ end }}
        <span class="lang-switcher__sep" aria-hidden="true">/</span>
        {{ if eq $lang "en" }}<span class="lang-switcher__link lang-switcher__link--active" lang="en" aria-current="true">EN</span>{{ else }}<a href="{{ $enURL }}" class="lang-switcher__link" lang="en" hreflang="en">EN</a>{{ end }}
      </nav>

      <a href="{{ if eq $lang "en" }}{{ contentURL "en-us/contact.md" }}{{ else }}{{ contentURL "contact.md" }}{{ end }}" class="header__nav-link header__nav-link--cta">Contact<span class="header__cta-arrow" aria-hidden="true">&rarr;</span></a>

      <button class="header__hamburger" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="{{ if eq $lang "en" }}Open menu{{ else }}Ouvrir le menu{{ end }}">
        <span class="header__hamburger-line"></span>
        <span class="header__hamburger-line"></span>
      </button>
    </div>
  </div>

  <div class="header__mobile-nav" id="mobile-nav" aria-hidden="true">
    <button class="header__mobile-close" type="button" aria-label="{{ if eq $lang "en" }}Close menu{{ else }}Fermer le menu{{ end }}">×</button>
    <nav aria-label="{{ if eq $lang "en" }}Mobile navigation{{ else }}Navigation mobile{{ end }}">
      <ul class="header__mobile-nav-list">
        <li><a href="{{ if eq $lang "en" }}{{ contentURL "en-us/approach.md" }}{{ else }}{{ contentURL "approche.md" }}{{ end }}" class="header__mobile-nav-link">{{ if eq $lang "en" }}Approach{{ else }}Approche{{ end }}</a></li>
        <li class="header__mobile-nav-group">
          <a href="{{ if eq $lang "en" }}{{ contentURL "en-us/expertise.md" }}{{ else }}{{ contentURL "expertises.md" }}{{ end }}" class="header__mobile-nav-link">{{ if eq $lang "en" }}Services{{ else }}Offres{{ end }}</a>
          <ul class="header__mobile-subnav-list">
            <li><a href="{{ if eq $lang "en" }}{{ contentURL "en-us/fractional-cto.md" }}{{ else }}{{ contentURL "cto-temps-partage.md" }}{{ end }}" class="header__mobile-subnav-link">{{ if eq $lang "en" }}Fractional CTO{{ else }}CTO à temps partagé{{ end }}</a></li>
            <li><a href="{{ if eq $lang "en" }}{{ contentURL "en-us/interim-cto.md" }}{{ else }}{{ contentURL "cto-de-transition.md" }}{{ end }}" class="header__mobile-subnav-link">{{ if eq $lang "en" }}Interim CTO{{ else }}CTO de transition{{ end }}</a></li>
            <li><a href="{{ if eq $lang "en" }}{{ contentURL "en-us/ai-transformation.md" }}{{ else }}{{ contentURL "transformation-ia.md" }}{{ end }}" class="header__mobile-subnav-link">{{ if eq $lang "en" }}AI transformation{{ else }}Transformation IA{{ end }}</a></li>
            <li><a href="{{ if eq $lang "en" }}{{ contentURL "en-us/fixed-price-projects.md" }}{{ else }}{{ contentURL "missions-au-forfait.md" }}{{ end }}" class="header__mobile-subnav-link">{{ if eq $lang "en" }}Fixed-price projects{{ else }}Missions au forfait{{ end }}</a></li>
          </ul>
        </li>
        <li><a href="{{ if eq $lang "en" }}{{ contentURL "en-us/articles/README.md" }}{{ else }}{{ contentURL "articles/README.md" }}{{ end }}" class="header__mobile-nav-link">Articles</a></li>
        <li><a href="{{ if eq $lang "en" }}{{ contentURL "en-us/references.md" }}{{ else }}{{ contentURL "references.md" }}{{ end }}" class="header__mobile-nav-link">{{ if eq $lang "en" }}References{{ else }}Références{{ end }}</a></li>
        <li><a href="{{ if eq $lang "en" }}{{ contentURL "en-us/contact.md" }}{{ else }}{{ contentURL "contact.md" }}{{ end }}" class="header__mobile-nav-link header__mobile-nav-link--cta">Contact</a></li>
      </ul>
    </nav>
    <div class="header__mobile-lang">
      <nav class="lang-switcher" aria-label="{{ if eq $lang "en" }}Language{{ else }}Langue{{ end }}">
        {{ if eq $lang "fr" }}<span class="lang-switcher__link lang-switcher__link--active" lang="fr" aria-current="true">FR</span>{{ else }}<a href="{{ $frURL }}" class="lang-switcher__link" lang="fr" hreflang="fr">FR</a>{{ end }}
        <span class="lang-switcher__sep" aria-hidden="true">/</span>
        {{ if eq $lang "en" }}<span class="lang-switcher__link lang-switcher__link--active" lang="en" aria-current="true">EN</span>{{ else }}<a href="{{ $enURL }}" class="lang-switcher__link" lang="en" hreflang="en">EN</a>{{ end }}
      </nav>
    </div>
  </div>
</header>
{{ end }}
