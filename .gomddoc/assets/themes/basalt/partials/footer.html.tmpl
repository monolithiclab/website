{{ define "footer" }}
{{- $lang := or (index .Page.Meta "lang") "fr" -}}
<footer class="footer">
  <div class="footer__grid">
    <div class="footer__brand">
      <a href="{{ if eq $lang "en" }}{{ contentURL "en-us/README.md" }}{{ else }}/{{ end }}" class="footer__logo-text">Monolithic Lab</a>
      <span class="footer__tagline">{{ if eq $lang "en" }}Fractional CTO, interim CTO, and AI transformation for small and mid-sized companies{{ else }}CTO à temps partagé, CTO de transition et transformation IA pour PME et scale-ups{{ end }}</span>
    </div>
    <div>
      <h3 class="footer__heading">Navigation</h3>
      <ul class="footer__list">
        <li><a href="{{ if eq $lang "en" }}{{ contentURL "en-us/approach.md" }}{{ else }}{{ contentURL "approche.md" }}{{ end }}" class="footer__link">{{ if eq $lang "en" }}Approach{{ else }}Approche{{ end }}</a></li>
        <li><a href="{{ if eq $lang "en" }}{{ contentURL "en-us/fractional-cto.md" }}{{ else }}{{ contentURL "cto-temps-partage.md" }}{{ end }}" class="footer__link">{{ if eq $lang "en" }}Fractional CTO{{ else }}CTO à temps partagé{{ end }}</a></li>
        <li><a href="{{ if eq $lang "en" }}{{ contentURL "en-us/interim-cto.md" }}{{ else }}{{ contentURL "cto-de-transition.md" }}{{ end }}" class="footer__link">{{ if eq $lang "en" }}Interim CTO{{ else }}CTO de transition{{ end }}</a></li>
        <li><a href="{{ if eq $lang "en" }}{{ contentURL "en-us/ai-transformation.md" }}{{ else }}{{ contentURL "transformation-ia.md" }}{{ end }}" class="footer__link">{{ if eq $lang "en" }}AI transformation{{ else }}Transformation IA{{ end }}</a></li>
        <li><a href="{{ if eq $lang "en" }}{{ contentURL "en-us/expertise.md" }}{{ else }}{{ contentURL "expertises.md" }}{{ end }}" class="footer__link">{{ if eq $lang "en" }}Services{{ else }}Offres{{ end }}</a></li>
        <li><a href="{{ if eq $lang "en" }}{{ contentURL "en-us/articles/README.md" }}{{ else }}{{ contentURL "articles/README.md" }}{{ end }}" class="footer__link">Articles</a></li>
        <li><a href="{{ if eq $lang "en" }}{{ contentURL "en-us/references.md" }}{{ else }}{{ contentURL "references.md" }}{{ end }}" class="footer__link">{{ if eq $lang "en" }}References{{ else }}Références{{ end }}</a></li>
        <li><a href="{{ if eq $lang "en" }}{{ contentURL "en-us/faq.md" }}{{ else }}{{ contentURL "faq.md" }}{{ end }}" class="footer__link">FAQ</a></li>
        <li><a href="{{ if eq $lang "en" }}{{ contentURL "en-us/contact.md" }}{{ else }}{{ contentURL "contact.md" }}{{ end }}" class="footer__link">{{ if eq $lang "en" }}Contact{{ else }}Contact{{ end }}</a></li>
      </ul>
    </div>
    <div>
      <h3 class="footer__heading">Contact</h3>
      <ul class="footer__list">
        <li><a href="mailto:contact@monolithiclab.fr" class="footer__link">contact@monolithiclab.fr</a></li>
        <li><address class="footer__address">14 rue de Cambrai, 75019 Paris</address></li>
      </ul>
    </div>
  </div>
  <div class="footer__bottom">
    <span class="footer__copy">&copy; 2026 Monolithic Lab SASU</span>
    <div class="footer__legal-links">
      <a href="{{ if eq $lang "en" }}{{ contentURL "en-us/legal.md" }}{{ else }}{{ contentURL "mentions-legales.md" }}{{ end }}" class="footer__legal">{{ if eq $lang "en" }}Legal notice{{ else }}Mentions légales{{ end }}</a>
      {{- if index .Site.Theme.Vars "gtm_id" }}
      <button type="button" class="footer__legal footer__cookie-manage" data-cookie-manage>{{ if eq $lang "en" }}Manage cookies{{ else }}Gérer les cookies{{ end }}</button>
      {{- end }}
    </div>
  </div>
</footer>
{{ end }}
