{{ define "head" }}
{{- $lang := or (index .Page.Meta "lang") "fr" -}}
{{- $isHome := or (eq .Page.Path "/") (eq .Page.Path "/en-us/") -}}
{{- $title := index .Page.Meta "title" -}}
{{- $description := or (index .Page.Meta "description") .Site.Meta.Description -}}
{{- $alternate := index .Page.Meta "alternate" -}}
{{- $canonical := canonicalURL .Page.Path -}}
{{- /* Error pages arrive with an English status line for a title ("Not Found")
       and a /404 path. Give them a French title and no canonical, which also
       suppresses the Open Graph and hreflang blocks below — none of it belongs
       on a page that should stay out of the index. */ -}}
{{- $errorCode := index .Page.Meta "error_code" -}}
{{- if $errorCode -}}
  {{- $title = printf "Page introuvable (%v) — %s" $errorCode .Site.Meta.Title -}}
  {{- $canonical = "" -}}
{{- end -}}
{{- $robots := index .Page.Meta "robots" -}}
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ if $title }}{{ $title }}{{ else }}{{ .Site.Meta.Title }}{{ end }}</title>
  <meta name="description" content="{{ $description }}">
  {{ if $robots }}<meta name="robots" content="{{ $robots }}">{{ end }}
  {{ if $canonical }}<link rel="canonical" href="{{ $canonical }}">{{ end }}

  <!-- Fonts. Self-hosted: no request leaves for fonts.googleapis.com or
       fonts.gstatic.com, so no visitor IP reaches Google before consent.
       The @font-face rules live in main.css, inlined below. Only the two latin
       files are preloaded — latin-ext is for accented outliers and its
       unicode-range keeps it out of the way until something needs it. -->
  <link rel="preload" as="font" type="font/woff2" href="/fonts/big-shoulders-display-latin.woff2" crossorigin>
  <link rel="preload" as="font" type="font/woff2" href="/fonts/hanken-grotesk-latin.woff2" crossorigin>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">

  <!-- Stylesheet. _tokens.css holds the palette and is generated — it comes
       first so main.css can read the custom properties it defines. -->
  <style>{{ inlineCSSAsset "_tokens.css" }}</style>
  <style>{{ inlineCSSAsset "main.css" }}</style>

  <!-- Open Graph -->
  {{ if $canonical }}
  <meta property="og:title" content="{{ or $title .Site.Meta.Title }}">
  <meta property="og:description" content="{{ $description }}">
  <meta property="og:type" content="{{ if $isHome }}website{{ else }}article{{ end }}">
  <meta property="og:url" content="{{ $canonical }}">
  <meta property="og:locale" content="{{ if eq $lang "en" }}en_US{{ else }}fr_FR{{ end }}">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ or $title .Site.Meta.Title }}">
  <meta name="twitter:description" content="{{ $description }}">
  {{ end }}

  <!-- Hreflang -->
  {{ if $alternate }}
  {{ if eq $lang "en" }}
  <link rel="alternate" hreflang="en" href="{{ $canonical }}">
  <link rel="alternate" hreflang="fr" href="https://{{ .Site.Meta.Domain }}{{ $alternate }}">
  <link rel="alternate" hreflang="x-default" href="https://{{ .Site.Meta.Domain }}{{ $alternate }}">
  {{ else }}
  <link rel="alternate" hreflang="fr" href="{{ $canonical }}">
  <link rel="alternate" hreflang="en" href="https://{{ .Site.Meta.Domain }}{{ $alternate }}">
  <link rel="alternate" hreflang="x-default" href="{{ $canonical }}">
  {{ end }}
  {{ end }}

  <!-- Google Tag Manager -->
  {{ $gtmID := index .Site.Theme.Vars "gtm_id" }}
  {{ if $gtmID }}
  <!-- Consent Mode default: must run before the GTM loader below so GTM/GA
       pick it up on their first pageview. Analytics stays denied until the
       cookie banner (main.js) records an explicit accept; ad_* stays denied
       permanently since this site runs no advertising tags. -->
  <script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('consent', 'default', {
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    analytics_storage: 'denied',
    wait_for_update: 500
  });
  </script>
  <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','{{ $gtmID }}');</script>
  {{ end }}
  <!-- End Google Tag Manager -->

  <!-- JSON-LD -->
  {{ if $isHome }}
  {{ if eq $lang "fr" }}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Monolithic Lab",
    "url": "https://monolithiclab.fr",
    "description": "{{ .Site.Meta.Description }}",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "14 rue de Cambrai",
      "addressLocality": "Paris",
      "postalCode": "75019",
      "addressCountry": "FR"
    },
    "founder": {
      "@type": "Person",
      "name": "Nicolas Mussat"
    }
  }
  </script>
  {{ end }}
  {{ end }}
</head>
{{ end }}
