{{ define "hero" }}
{{- $hero := index .Page.Meta "hero" -}}
{{ if $hero }}
{{- $compact := index $hero "compact" -}}

{{ if not $compact }}
    <section class="hero-monolith" aria-label="Hero">
      <div class="hero-monolith__inner">
        <div class="hero-monolith__content">
          {{ $heroLabel := index $hero "label" }}
          {{ if $heroLabel }}<span class="hero-monolith__label">{{ $heroLabel }}</span>{{ end }}
          <h1 class="hero-monolith__headline">{{ index $hero "headline" }}</h1>
          {{ $heroSub := index $hero "subheadline" }}
          {{ if $heroSub }}<p class="hero-monolith__sub">{{ $heroSub }}</p>{{ end }}
          {{ $heroCTA := index $hero "cta_text" }}
          {{ $heroURL := index $hero "cta_url" }}
          {{ if $heroCTA }}<a href="{{ $heroURL }}" class="hero-monolith__cta">{{ $heroCTA }}<span class="hero-monolith__cta-arrow">&rarr;</span></a>{{ end }}
        </div>
      </div>
    </section>
{{ else }}
    <section class="hero-compact" aria-label="Hero">
      <div class="hero-compact__inner">
        {{ $heroLabel := index $hero "label" }}
        {{ if $heroLabel }}<span class="hero-compact__label">{{ $heroLabel }}</span>{{ end }}
        <h1 class="hero-compact__headline">{{ index $hero "headline" }}</h1>
        {{ $heroSub := index $hero "subheadline" }}
        {{ if $heroSub }}<p class="hero-compact__sub">{{ $heroSub }}</p>{{ end }}
      </div>
    </section>
{{ end }}

{{ end }}
{{ end }}
