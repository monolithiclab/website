{{ define "header" }}
{{- $lang := or (index .Page.Meta "lang") "fr" -}}
{{- $isHome := eq (or (index .Page.Meta "layout") "page") "home" -}}
{{- $frURL := "#" -}}
{{- $enURL := "#" -}}
{{- if eq $lang "en" -}}
  {{- $frURL = or (index .Page.Meta "alternate") "/" -}}
{{- else -}}
  {{- $enURL = or (index .Page.Meta "alternate") "/en-us/" -}}
{{- end -}}
<header class="header{{ if $isHome }} header--home{{ end }}" id="site-header">
  <div class="header__inner">
    <a href="{{ if eq $lang "en" }}{{ contentURL "en-us/README.md" }}{{ else }}/{{ end }}" class="header__logo" aria-label="{{ if eq $lang "en" }}Monolithic — Home{{ else }}Monolithic — Accueil{{ end }}">
      <span class="header__logo-text">Monolithic</span>
    </a>

    <nav class="header__nav" aria-label="{{ if eq $lang "en" }}Main navigation{{ else }}Navigation principale{{ end }}">
      <ul class="header__nav-list">
        <li><a href="{{ if eq $lang "en" }}{{ contentURL "en-us/approach.md" }}{{ else }}{{ contentURL "approche.md" }}{{ end }}" class="header__nav-link">{{ if eq $lang "en" }}Approach{{ else }}Approche{{ end }}</a></li>
        <li class="header__nav-item header__nav-item--has-submenu">
          <a href="{{ if eq $lang "en" }}{{ contentURL "en-us/expertise.md" }}{{ else }}{{ contentURL "expertises.md" }}{{ end }}" class="header__nav-link">{{ if eq $lang "en" }}Expertise{{ else }}Expertises{{ end }}</a>
          <div class="header__submenu" aria-label="{{ if eq $lang "en" }}Expertise submenu{{ else }}Sous-menu expertises{{ end }}">
            <a href="{{ if eq $lang "en" }}{{ contentURL "en-us/fractional-cto.md" }}{{ else }}{{ contentURL "cto-temps-partage.md" }}{{ end }}" class="header__submenu-link">{{ if eq $lang "en" }}Fractional CTO{{ else }}CTO à temps partagé{{ end }}</a>
            <a href="{{ if eq $lang "en" }}{{ contentURL "en-us/expertise.md" }}{{ else }}{{ contentURL "expertises.md" }}{{ end }}" class="header__submenu-link">{{ if eq $lang "en" }}Operating structure{{ else }}Structuration des opérations{{ end }}</a>
            <a href="{{ if eq $lang "en" }}{{ contentURL "en-us/expertise.md" }}{{ else }}{{ contentURL "expertises.md" }}{{ end }}" class="header__submenu-link">{{ if eq $lang "en" }}Systems & integrations{{ else }}Systèmes & intégrations{{ end }}</a>
            <a href="{{ if eq $lang "en" }}{{ contentURL "en-us/expertise.md" }}{{ else }}{{ contentURL "expertises.md" }}{{ end }}" class="header__submenu-link">{{ if eq $lang "en" }}AI workflows{{ else }}Workflows IA utiles{{ end }}</a>
          </div>
        </li>
        <li><a href="{{ if eq $lang "en" }}{{ contentURL "en-us/references.md" }}{{ else }}{{ contentURL "references.md" }}{{ end }}" class="header__nav-link">{{ if eq $lang "en" }}References{{ else }}Références{{ end }}</a></li>
        <li><a href="{{ if eq $lang "en" }}{{ contentURL "en-us/contact.md" }}{{ else }}{{ contentURL "contact.md" }}{{ end }}" class="header__nav-link header__nav-link--cta">Contact</a></li>
      </ul>
    </nav>

    <div class="header__actions">
      <div class="lang-switcher" aria-label="Language selector">
        <a href="{{ $frURL }}" class="lang-switcher__link{{ if eq $lang "fr" }} lang-switcher__link--active{{ end }}">FR</a>
        <span class="lang-switcher__sep">/</span>
        <a href="{{ $enURL }}" class="lang-switcher__link{{ if eq $lang "en" }} lang-switcher__link--active{{ end }}">EN</a>
      </div>

      <button class="header__hamburger" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="{{ if eq $lang "en" }}Open menu{{ else }}Ouvrir le menu{{ end }}">
        <span class="header__hamburger-line"></span>
        <span class="header__hamburger-line"></span>
      </button>
    </div>
  </div>

  <div class="header__mobile-nav" id="mobile-nav" aria-hidden="true">
    <button class="header__mobile-close" type="button" aria-label="{{ if eq $lang "en" }}Close menu{{ else }}Fermer le menu{{ end }}">×</button>
    <nav aria-label="{{ if eq $lang "en" }}Mobile navigation{{ else }}Navigation mobile{{ end }}">
      <ul class="header__mobile-nav-list">
        <li><a href="{{ if eq $lang "en" }}{{ contentURL "en-us/approach.md" }}{{ else }}{{ contentURL "approche.md" }}{{ end }}" class="header__mobile-nav-link">{{ if eq $lang "en" }}Approach{{ else }}Approche{{ end }}</a></li>
        <li class="header__mobile-nav-group">
          <a href="{{ if eq $lang "en" }}{{ contentURL "en-us/expertise.md" }}{{ else }}{{ contentURL "expertises.md" }}{{ end }}" class="header__mobile-nav-link">{{ if eq $lang "en" }}Expertise{{ else }}Expertises{{ end }}</a>
          <ul class="header__mobile-subnav-list">
            <li><a href="{{ if eq $lang "en" }}{{ contentURL "en-us/fractional-cto.md" }}{{ else }}{{ contentURL "cto-temps-partage.md" }}{{ end }}" class="header__mobile-subnav-link">{{ if eq $lang "en" }}Fractional CTO{{ else }}CTO à temps partagé{{ end }}</a></li>
            <li><a href="{{ if eq $lang "en" }}{{ contentURL "en-us/expertise.md" }}{{ else }}{{ contentURL "expertises.md" }}{{ end }}" class="header__mobile-subnav-link">{{ if eq $lang "en" }}Operating structure{{ else }}Structuration des opérations{{ end }}</a></li>
            <li><a href="{{ if eq $lang "en" }}{{ contentURL "en-us/expertise.md" }}{{ else }}{{ contentURL "expertises.md" }}{{ end }}" class="header__mobile-subnav-link">{{ if eq $lang "en" }}Systems & integrations{{ else }}Systèmes & intégrations{{ end }}</a></li>
            <li><a href="{{ if eq $lang "en" }}{{ contentURL "en-us/expertise.md" }}{{ else }}{{ contentURL "expertises.md" }}{{ end }}" class="header__mobile-subnav-link">{{ if eq $lang "en" }}AI workflows{{ else }}Workflows IA utiles{{ end }}</a></li>
          </ul>
        </li>
        <li><a href="{{ if eq $lang "en" }}{{ contentURL "en-us/references.md" }}{{ else }}{{ contentURL "references.md" }}{{ end }}" class="header__mobile-nav-link">{{ if eq $lang "en" }}References{{ else }}Références{{ end }}</a></li>
        <li><a href="{{ if eq $lang "en" }}{{ contentURL "en-us/contact.md" }}{{ else }}{{ contentURL "contact.md" }}{{ end }}" class="header__mobile-nav-link header__mobile-nav-link--cta">Contact</a></li>
      </ul>
    </nav>
    <div class="header__mobile-lang">
      <div class="lang-switcher" aria-label="Language selector">
        <a href="{{ $frURL }}" class="lang-switcher__link{{ if eq $lang "fr" }} lang-switcher__link--active{{ end }}">FR</a>
        <span class="lang-switcher__sep">/</span>
        <a href="{{ $enURL }}" class="lang-switcher__link{{ if eq $lang "en" }} lang-switcher__link--active{{ end }}">EN</a>
      </div>
    </div>
  </div>
</header>
{{ end }}
