{{ define "cta-band" }}
{{- $ctaBand := index .Page.Meta "cta_band" -}}
{{ if $ctaBand }}
    <section class="cta-band" data-reveal>
      <div class="cta-band__inner">
        <p class="cta-band__text">{{ index $ctaBand "text" }}</p>
        <a href="{{ index $ctaBand "button_url" }}" class="cta-band__btn">{{ index $ctaBand "button_text" }}<span class="cta-band__btn-arrow">&rarr;</span></a>
      </div>
    </section>
{{ end }}
{{ end }}
